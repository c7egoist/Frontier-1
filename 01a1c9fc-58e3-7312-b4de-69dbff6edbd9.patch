+        partIdx: pIdx,
+        partName: parts[pIdx].name,
+        a: [ax, ay, az],
+        b: [bx, by, bz],
+        c: [cx, cy, cz],
+        na: [norm.getX(i0), norm.getY(i0), norm.getZ(i0)],
+        nb: [norm.getX(i1), norm.getY(i1), norm.getZ(i1)],
+        nc: [norm.getX(i2), norm.getY(i2), norm.getZ(i2)],
+        fn: [fnx, fny, fnz],
