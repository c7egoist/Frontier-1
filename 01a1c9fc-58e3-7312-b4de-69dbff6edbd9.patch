+            }
+            else if (Cmd === 'vt' && Parts.length >= 3)
+            {
+                RawUVs.push([parseFloat(Parts[1]) || 0, parseFloat(Parts[2]) || 0]);
+            }
+            else if ((Cmd === 'g' || Cmd === 'o') && Parts.length >= 2)
+            {
+                CurrentGroup = Parts.slice(1).join(' ');
+            }
+            else if (Cmd === 'usemtl' && Parts.length >= 2)
+            {
