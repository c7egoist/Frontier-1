+  let vc = d1 * d4 - d3 * d2;
+  if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
+    let v = d1 / (d1 - d3);
+    let q = a + ab * v - p;
+    return dot(q, q);
+  }
