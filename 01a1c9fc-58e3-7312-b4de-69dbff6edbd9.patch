+      const si = (sy * srcW + sx) * 4;
+      const di = (y * targetSize + x) * 4;
+      dst[di] = rgba[si];
+      dst[di + 1] = rgba[si + 1];
+      dst[di + 2] = rgba[si + 2];
+      dst[di + 3] = rgba[si + 3];
