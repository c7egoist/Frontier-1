+        let HadUVs = RawUVs.length > 0;
+        const UvCoords = RawUVs.length ? RawUVs.map(U => [U[0], U[1]]) : [];
+        if (!HadUVs)
+        {
+            for (const F of Faces)
+            {
+                for (const C of F.corners)
+                {
+                    const P = Positions[C.v];
+                    C.uv = UvCoords.length;
+                    UvCoords.push([P[0] * 0.35 + 0.5, P[1] * 0.35 + 0.5]);
+                }
+            }
+        }
+        else
+        {
+            for (const F of Faces)
+            {
+                for (const C of F.corners)
