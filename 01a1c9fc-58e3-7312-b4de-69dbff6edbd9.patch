+fn intersectTri(ro: vec3<f32>, rd: vec3<f32>, ti: u32) -> RayHit {
+  var rh: RayHit;
+  rh.hit = 0u;
+  let tr = tris[ti];
+  let e1 = tr.b.xyz - tr.a.xyz;
+  let e2 = tr.c.xyz - tr.a.xyz;
+  let pv = cross(rd, e2);
+  let det = dot(e1, pv);
+  if (abs(det) < 1e-8) { return rh; }
+  let inv = 1.0 / det;
