+  if (t > 0.0001) {
+    rh.hit = 1u;
+    rh.t = t;
+    rh.u = u;
+    rh.v = v;
+    rh.w = 1.0 - u - v;
+    rh.triIdx = ti;
+  }
+  return rh;
