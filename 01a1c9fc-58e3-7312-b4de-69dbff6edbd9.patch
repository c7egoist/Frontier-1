+                    let VtIdx = Toks[1] ? parseInt(Toks[1], 10) : NaN;
+                    if (Number.isFinite(VtIdx))
+                    {
+                        VtIdx = VtIdx < 0 ? RawUVs.length + VtIdx : VtIdx - 1;
+                    }
+                    else
+                    {
+                        VtIdx = -1;
+                    }
+                    if (VIdx >= 0 && VIdx < Positions.length) Corners.push({ v: VIdx, uv: VtIdx });
+                }
+                if (Corners.length >= 3)
+                {
+                    Faces.push({
+                        id: Faces.length,
+                        name: CurrentGroup,
+                        partId: CurrentGroup,
+                        materialName: CurrentMaterial,
+                        corners: Corners
