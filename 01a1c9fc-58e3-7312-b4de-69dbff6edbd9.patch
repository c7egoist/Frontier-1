+          ctx.save();
+          ctx.beginPath();
+          ctx.rect(i * 1028, j * 1028, 1028, 1028);
+          ctx.clip();
+          ctx.drawImage(patch, x + dx * 1024, y + dy * 1024);
+          ctx.restore();
+        }
+    }
