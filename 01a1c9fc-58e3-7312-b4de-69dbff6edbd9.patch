+          evaluateAndRender(true);
+          rebuildInspector();
+          return;
+        }
+      }
+    }
+    if ((e.key === "Backspace" || e.key === "Delete") && activePathSession && !activePathSession.editingLayerId) {
+      e.preventDefault();
+      if (activePathSession.nodes.length > 1) {
+        activePathSession.nodes.pop();
+        syncPathSessionHints();
