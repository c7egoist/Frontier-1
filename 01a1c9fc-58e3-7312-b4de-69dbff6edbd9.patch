+  const d6 = acx * cpx + acy * cpy + acz * cpz;
+  if (d6 >= 0 && d5 <= d6) return cpx * cpx + cpy * cpy + cpz * cpz;
+
+  const vb = d5 * d2 - d1 * d6;
+  if (vb <= 0 && d2 >= 0 && d6 <= 0) {
+    const w = d2 / (d2 - d6);
+    const dx = a[0] + acx * w - px, dy = a[1] + acy * w - py, dz = a[2] + acz * w - pz;
+    return dx * dx + dy * dy + dz * dz;
+  }
+
+  const va = d3 * d6 - d5 * d4;
