+          let hitsX = 0;
+          const maxRay = span.x + 1.0;
+          let ox = wx;
+          for (let step = 0; step < 12; step++) {
+            const h = raycastAccel(accel, ox, wy, wz, 1, 0, 0, maxRay, true);
