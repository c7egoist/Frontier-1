+
+    _RenderBaseLayer(Ctx, W, H, State, GroupColors, EdgeTopo)
+    {
+        const {
+            surface,
+            islands,
+            udimTiles,
+            activeUdim,
+            overlayLens,
+            showChecker,
+            showSubGrid,
+            showSeams,
+            showBoundaries,
+            targetTexelDensity,
+            diagnostics
