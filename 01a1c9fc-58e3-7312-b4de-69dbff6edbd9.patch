+        }
+
+        for (const Tile of udimTiles)
+        {
+            const O = UdimOrigin(Tile.id);
+            const X0 = HalfW + (O.u - Pu) * S, Y1 = HalfH - (O.v - Pv) * S;
+            const X1 = HalfW + (O.u + 1 - Pu) * S, Y0 = HalfH - (O.v + 1 - Pv) * S;
