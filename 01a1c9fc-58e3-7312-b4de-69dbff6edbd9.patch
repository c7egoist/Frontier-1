+   vec2 uv=surfaceUV(pp,weights)*uScale;uv.x+=floor(uv.y)*uTileStagger;
+   vec2 tile=floor(uv),q=fract(uv);float edge=min(min(q.x,1.-q.x),min(q.y,1.-q.y));
+   float aa=max(max(fwidth(uv.x),fwidth(uv.y)),.001);
