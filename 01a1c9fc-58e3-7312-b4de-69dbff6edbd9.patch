+      ...richRugPattern("Azure Arabesque Medallion"),
+      name,
+      collection: spec.group,
+    };
+  if (name === "Islamic Garden Carpet")
+    return {
+      ...richRugPattern("Ivory Palmette Garden"),
+      name,
+      collection: spec.group,
+    };
