+                if (!Edges.has(K3))
+                {
+                    Edges.set(K3, {
+                        key: K3,
+                        va: Math.min(Va, Vb),
+                        vb: Math.max(Va, Vb),
+                        faces: [],
+                        uvEdges: new Set(),
+                        halfEdges: [],
+                        isMeshBoundary: false,
+                        dihedralDeg: 0
+                    });
+                }
+                const Info = Edges.get(K3);
+                if (!Info.faces.includes(fi)) Info.faces.push(fi);
+                Info.uvEdges.add(KUv);
+                Info.halfEdges.push({ fi, k, va: Va, vb: Vb, uva: Uva, uvb: Uvb, uvKey: KUv });
