+            name === "Diamond Dissolve"
+              ? [
+                  [0, -dy * 0.3],
+                  [dx * 0.18, 0],
+                  [0, dy * 0.3],
+                  [-dx * 0.18, 0],
+                ]
+              : [
+                  [0, 0],
+                  v[face * 2],
+                  v[(face * 2 + 1) % 6],
+                  v[(face * 2 + 2) % 6],
+                ];
