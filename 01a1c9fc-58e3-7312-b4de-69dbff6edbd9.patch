+    schema: "frontier.texture-paint.v2",
+    name: "Teapot Paint",
+    resolution: res,
+    meshId: "teapot",
+    layers: [baseFill, paintTop], // Bottom-to-top compositing order
+    selectedLayerId: paintTop.id,
+    editingMask: false,
+    bakedMaps: null, // Optional { normal, ao, curvature, height, worldNormal, res }
+  };
