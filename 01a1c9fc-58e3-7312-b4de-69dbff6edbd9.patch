+        for (let fi = 0; fi < this.faces.length; fi++)
+        {
+            const C = this.faces[fi].corners;
+            const Len = C.length;
+            for (let k = 0; k < Len; k++)
+            {
+                const Va = C[k].v;
+                const Vb = C[(k + 1) % Len].v;
+                const Uva = C[k].uv;
+                const Uvb = C[(k + 1) % Len].uv;
+                const K3 = EdgeKey(Va, Vb);
+                const KUv = EdgeKey(Uva, Uvb);
