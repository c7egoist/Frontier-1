+            const Ax = Pa[0] - P0[0], Ay = Pa[1] - P0[1], Az = Pa[2] - P0[2];
+            const Bx = Pb[0] - P0[0], By = Pb[1] - P0[1], Bz = Pb[2] - P0[2];
