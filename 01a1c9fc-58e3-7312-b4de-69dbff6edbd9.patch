+            const GrpColor = Isl.importanceGroupId ? GroupColors.get(Isl.importanceGroupId) : null;
+            const BaseColor = overlayLens === 'importance'
+                ? (GrpColor ? this.HexToRgba(GrpColor, 0.25) : 'rgba(145, 152, 162, 0.16)')
