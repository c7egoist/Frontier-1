+      const oldG = glowScalarBuf.alpha[i] / 255;
+      const outG = op + oldG * (1 - op);
+      if (outG > 1e-4) glowScalarBuf.values[i] = Math.round((glowByte * op + glowScalarBuf.values[i] * oldG * (1 - op)) / outG);
