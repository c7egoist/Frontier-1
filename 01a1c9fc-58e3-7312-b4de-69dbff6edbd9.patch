+  const denom = 1 / (va + vb + vc);
+  const v = vb * denom, w = vc * denom;
+  const dx = a[0] + abx * v + acx * w - px;
+  const dy = a[1] + aby * v + acy * w - py;
+  const dz = a[2] + abz * v + acz * w - pz;
+  return dx * dx + dy * dy + dz * dz;
+}
+
+function closestDistanceAccel(accel, px, py, pz) {
