+.uv-stamp-overlay {
+    position: absolute;
+    inset: 0;
+    pointer-events: none;
+    z-index: 6;
+}
+.uv-stamp-box {
+    position: absolute;
+    border: 1.5px solid #eff4cf;
+    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.72), 0 0 12px rgba(239, 244, 207, 0.25);
+    pointer-events: auto;
+    cursor: move;
+    transform-origin: center center;
+}
+.uv-stamp-center {
+    position: absolute;
+    left: 50%;
+    top: 50%;
+    width: 8px;
+    height: 8px;
+    margin: -4px 0 0 -4px;
+    border-radius: 999px;
+    background: #eff4cf;
+    border: 1px solid #0e0f12;
+    pointer-events: none;
+}
+.uv-stamp-handle {
+    position: absolute;
+    width: 10px;
+    height: 10px;
+    border-radius: 2px;
+    background: #eff4cf;
+    border: 1px solid #0e0f12;
+    pointer-events: auto;
+}
+.uv-stamp-handle.nw { left: -6px; top: -6px; cursor: nwse-resize; }
+.uv-stamp-handle.ne { right: -6px; top: -6px; cursor: nesw-resize; }
+.uv-stamp-handle.sw { left: -6px; bottom: -6px; cursor: nesw-resize; }
+.uv-stamp-handle.se { right: -6px; bottom: -6px; cursor: nwse-resize; }
+.uv-stamp-rot {
+    position: absolute;
+    left: 50%;
+    top: -22px;
+    width: 12px;
+    height: 12px;
+    margin-left: -6px;
+    border-radius: 999px;
+    background: #6ea8ff;
+    border: 1.5px solid #0e0f12;
+    cursor: grab;
+    pointer-events: auto;
+}
+.uv-stamp-rot::after {
+    content: "";
+    position: absolute;
+    left: 50%;
+    top: 100%;
+    width: 1.5px;
+    height: 10px;
+    margin-left: -0.75px;
+    background: #6ea8ff;
+}
