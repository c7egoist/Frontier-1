+          const albR = clamp01(br * (1 - flakes * 0.12) + sr * (flakes * 0.12 + micro * 0.6));
+          const albG = clamp01(bg * (1 - flakes * 0.12) + sg * (flakes * 0.12 + micro * 0.6));
