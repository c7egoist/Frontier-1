+  for (let pass = 0; pass < paddingPx; pass++) {
+    const writes = [];
+    for (let y = 0; y < res; y++) {
+      for (let x = 0; x < res; x++) {
+        const pid = y * res + x;
+        if (curMask[pid]) continue;
+        let r = 0, g = 0, b = 0, a = 0, cnt = 0;
+        for (const [dx, dy] of dirs) {
+          const nx = x + dx, ny = y + dy;
+          if (nx < 0 || nx >= res || ny < 0 || ny >= res) continue;
+          const nid = ny * res + nx;
+          if (!curMask[nid]) continue;
+          r += nextRgba[nid * 4];
+          g += nextRgba[nid * 4 + 1];
+          b += nextRgba[nid * 4 + 2];
+          a += nextRgba[nid * 4 + 3];
+          cnt++;
+        }
+        if (cnt > 0) {
+          writes.push([pid, Math.round(r / cnt), Math.round(g / cnt), Math.round(b / cnt), Math.round(a / cnt)]);
+        }
+      }
+    }
+    if (!writes.length) break;
+    for (const [pid, r, g, b, a] of writes) {
+      curMask[pid] = 1;
+      nextRgba[pid * 4] = r;
+      nextRgba[pid * 4 + 1] = g;
+      nextRgba[pid * 4 + 2] = b;
