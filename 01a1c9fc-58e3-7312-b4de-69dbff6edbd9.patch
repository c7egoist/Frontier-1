+  onProgress(1, "Volume SDF complete");
+  return {
+    dims: [nx, ny, nz],
+    min: [min.x, min.y, min.z],
+    max: [max.x, max.y, max.z],
+    minVal,
+    maxVal,
+    signed,
+    values,
+  };
