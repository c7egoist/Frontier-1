+      if (outA <= 0.005) continue;
+      const i4 = (py * size + px) * 4;
+      data[i4] = tone(outR);
+      data[i4 + 1] = tone(outG);
+      data[i4 + 2] = tone(outB);
+      data[i4 + 3] = Math.round(clamp01(outA) * 255);
+    }
+  }
