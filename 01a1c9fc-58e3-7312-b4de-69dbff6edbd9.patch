+   vec3 domain=pp*uScale;domain+=vec3(noise3(domain*.3),noise3(domain*.3+7.),noise3(domain*.3+21.))*.6;
+   vec4 mineral=cellular3(domain,19.);
+   vec3 color=mineral.y<.23?uTertiary:(mineral.y<.58?uSecondary:diffuseColor.rgb);
