+        const idx = (z * ny + y) * nx + x;
+        values[idx] = dist;
+        if (dist < minVal) minVal = dist;
+        if (dist > maxVal) maxVal = dist;
+      }
+    }
+    if (z % 4 === 0) {
+      onProgress(0.1 + 0.9 * (z / nz), `Baking Volume SDF slice ${z + 1}/${nz}`);
+      await tick();
+    }
