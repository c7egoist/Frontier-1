+            if (R2 > 1.0)
+            {
+                const Edge = Math.max(0, 1 - (R2 - 1) * 6);
+                Data[idx] = BaseDark[0];
+                Data[idx + 1] = BaseDark[1];
+                Data[idx + 2] = BaseDark[2];
+                Data[idx + 3] = Math.round(Edge * 255);
+                continue;
+            }
