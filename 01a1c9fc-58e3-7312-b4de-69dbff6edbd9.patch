+export function normalizePaintSettings(raw = {}) {
+  if (!raw || typeof raw !== "object" || Array.isArray(raw)) raw = {};
+  const tool = paintTool(raw.toolId),
+    params = {};
+  for (const group of SchemaFor(tool))
+    for (const c of group.controls) {
+      const value = raw.params?.[c.k];
+      if (c.type === "slider")
+        params[c.k] = Number.isFinite(Number(value))
+          ? Math.min(c.max, Math.max(c.min, Number(value)))
+          : c.def;
+      else if (c.type === "switch")
+        params[c.k] = typeof value === "boolean" ? value : c.def;
+      else params[c.k] = c.opts.includes(value) ? value : c.def;
+    }
+  return {
+    toolId: tool.id,
+    color: /^#[a-f0-9]{6}$/i.test(raw.color || "")
+      ? raw.color.toLowerCase()
+      : PAINT_SWATCHES[tool.key]?.[0] || "#222222",
+    params,
+  };
