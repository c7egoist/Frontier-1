+          let sG = (albG * (diffWeight + amb * (0.45 + 0.55 * (1 - metal))) + specG * (specKey + specFill) + coatSpec) * cavityShade;
+          let sB = (albB * (diffWeight + amb * (0.45 + 0.55 * (1 - metal))) + specB * (specKey + specFill) + coatSpec) * cavityShade;
