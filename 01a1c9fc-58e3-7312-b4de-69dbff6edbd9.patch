+    const Tex = new THREE.CanvasTexture(Canvas);
+    Tex.wrapS = THREE.RepeatWrapping;
+    Tex.wrapT = THREE.RepeatWrapping;
+    Tex.colorSpace = THREE.SRGBColorSpace;
+    Tex.anisotropy = 4;
+    return Tex;
+}
+
+function BuildMatcapTexture(Variant = 'clay')
+{
+    const Size = 512;
+    const Canvas = document.createElement('canvas');
+    Canvas.width = Size;
+    Canvas.height = Size;
+    const Ctx = Canvas.getContext('2d');
+    const Img = Ctx.createImageData(Size, Size);
+    const Data = Img.data;
+
+    const Profiles = {
+        clay: { dark: [74, 46, 36], mid: [178, 120, 96], specular: [255, 232, 214], rim: [158, 207, 255], exponent: 22, strength: 0.42, fresnel: 0.24 },
+        satin: { dark: [24, 27, 32], mid: [92, 100, 110], specular: [239, 244, 207], rim: [138, 186, 224], exponent: 42, strength: 0.85, fresnel: 0.42 },
+        copper: { dark: [56, 24, 17], mid: [181, 89, 42], specular: [255, 212, 142], rim: [255, 116, 61], exponent: 32, strength: 0.62, fresnel: 0.30 },
+        ceramic: { dark: [43, 48, 52], mid: [183, 194, 196], specular: [255, 255, 245], rim: [191, 224, 233], exponent: 58, strength: 0.70, fresnel: 0.20 },
+        'blue-steel': { dark: [18, 34, 49], mid: [76, 126, 158], specular: [207, 235, 255], rim: [112, 186, 233], exponent: 38, strength: 0.72, fresnel: 0.35 }
+    };
+    const Profile = Profiles[Variant] || Profiles.clay;
+    const BaseDark = Profile.dark;
+    const BaseMid = Profile.mid;
+    const SpecCol = Profile.specular;
+    const RimCol = Profile.rim;
+
+    const Lx = 0.40, Ly = 0.58, Lz = 0.707;
+    const Hx = Lx * 0.5, Hy = Ly * 0.5, Hz = (Lz + 1) * 0.5;
+    const HLen = Math.hypot(Hx, Hy, Hz);
+    const Hnx = Hx / HLen, Hny = Hy / HLen, Hnz = Hz / HLen;
+
+    const Fx = -0.58, Fy = -0.35, Fz = 0.73;
+
+    for (let y = 0; y < Size; y++)
+    {
+        const Ny = 1 - (2 * (y + 0.5)) / Size;
+        for (let x = 0; x < Size; x++)
+        {
+            const Nx = (2 * (x + 0.5)) / Size - 1;
+            const R2 = Nx * Nx + Ny * Ny;
+            const Nz = R2 <= 1 ? Math.sqrt(1 - R2) : 0;
+            const idx = (y * Size + x) * 4;
