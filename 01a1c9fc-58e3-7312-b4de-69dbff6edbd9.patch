+    const wz = min.z + ((z + 0.5) / nz) * span.z;
+    for (let y = 0; y < ny; y++) {
+      const wy = min.y + ((y + 0.5) / ny) * span.y;
+      for (let x = 0; x < nx; x++) {
+        const wx = min.x + ((x + 0.5) / nx) * span.x;
+        let dist = closestDistanceAccel(accel, wx, wy, wz);
