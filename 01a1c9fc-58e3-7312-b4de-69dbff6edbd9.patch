+}
+
+const ptGradCache = new Map();
+function getPointGradientCanvasAndUrl(rawGrad, { res = 128, size = ARTWORK_SIZE, seamless = false } = {}) {
+  const g = normalizePointGradient2D(rawGrad, "#eff4cf", "#5a7692", size);
