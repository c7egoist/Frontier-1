+    layers: doc.layers.map((l) =>
+      l.locked
+        ? l
+        : {
+            ...l,
+            ...(l.color === from ? { color: to } : {}),
+            ...(l.paint && l.stroke === from ? { stroke: to } : {}),
+          },
+    ),
+  };
