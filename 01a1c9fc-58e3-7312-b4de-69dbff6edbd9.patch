+      state.lastElapsedMs = Math.round(performance.now() - tStart);
+      state.lastDevice = `${deviceUsed} · ${state.lastElapsedMs} ms`;
+      if (gpuLabelSpan) gpuLabelSpan.textContent = state.lastDevice;
