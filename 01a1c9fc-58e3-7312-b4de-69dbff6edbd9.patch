+            Data[idx] = R;
+            Data[idx + 1] = G;
+            Data[idx + 2] = B;
+            Data[idx + 3] = 255;
+        }
+    }
+    Ctx.putImageData(Img, 0, 0);
+    const Tex = new THREE.CanvasTexture(Canvas);
+    Tex.colorSpace = THREE.SRGBColorSpace;
+    return Tex;
+}
+
+function BuildVertexDotTexture()
+{
+    const Size = 64;
