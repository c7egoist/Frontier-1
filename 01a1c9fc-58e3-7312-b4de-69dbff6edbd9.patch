+          case "Diamond grid":
+            diamond(cx, cy, 57, 1);
+            diamond(cx, cy, 46, 0);
+            diamond(cx, cy, 14, 2);
+            break;
+          case "Brick bond":
+            rect(px + (y % 2) * 64 + 3, py + 3, 122, 122, k);
+            break;
+          case "Wave lattice": {
+            const pts = [];
+            for (let i = 0; i <= 24; i++)
+              pts.push([
+                px + (i * 128) / 24,
+                py + 56 + Math.sin((i * Math.PI * 2) / 24) * 25,
+              ]);
+            for (let i = 24; i >= 0; i--)
