+function BuildCheckerTexture()
+{
+    const Size = 512;
+    const Canvas = document.createElement('canvas');
+    Canvas.width = Size;
+    Canvas.height = Size;
+    const Ctx = Canvas.getContext('2d');
+    const Cells = 8;
+    const Step = Size / Cells;
