+export function automaticPathNodes(nodes, closed = false, tension = 0.5) {
+  const list = Array.isArray(nodes) ? nodes.map((n) => ({
+    x: Number(n.x || 0),
+    y: Number(n.y || 0),
+    mode: n.mode || "auto",
