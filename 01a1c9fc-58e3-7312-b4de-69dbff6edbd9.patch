+        const h10 = u3 - 2 * u2 + u;
+        const h01 = -2 * u3 + 3 * u2;
+        const h11 = u3 - u2;
+        return h00 * v1 + h10 * m1 + h01 * v2 + h11 * m2;
+      };
+      const pos = [
+        cr(p0.pos[0], p1.pos[0], p2.pos[0], p3.pos[0]),
+        cr(p0.pos[1], p1.pos[1], p2.pos[1], p3.pos[1]),
