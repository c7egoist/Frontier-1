+
+export function createPaintDocument(res = PAINT_DEFAULT_RES) {
+  const baseFill = createPaintLayer("fill", {
+    res,
+    name: "Base Ceramic Coat",
+    fill: { color: "#cfd2d6", roughness: 0.34, metalness: 0.06, height: 0.0 },
+  });
