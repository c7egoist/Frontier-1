+      } else {
+        activePathSession = null;
+        syncPathSessionHints();
+        renderVectorSvgCanvas();
+      }
+      return;
+    }
+    if (e.key === "Escape") {
+      if (activePathSession) {
+        activePathSession = null;
+        syncPathSessionHints();
+        renderVectorSvgCanvas();
+        return;
+      }
+      closeArtPopup(); headerUI.closeSaveMenu(); return;
