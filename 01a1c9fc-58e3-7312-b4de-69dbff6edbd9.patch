+          // Composite sphere AA edge cleanly over pedestal AA where overlapping
+          outR = sR * sphAA + outR * (1 - sphAA);
+          outG = sG * sphAA + outG * (1 - sphAA);
+          outB = sB * sphAA + outB * (1 - sphAA);
+          outA = Math.max(outA, sphAA);
+        }
+      }
