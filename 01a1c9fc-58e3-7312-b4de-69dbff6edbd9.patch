+      closeArtPopup();
+      window.removeEventListener("keydown", onArtKeyDown);
+      window.removeEventListener("keyup", onArtKeyUp);
+      window.removeEventListener("pointerup", endSvgPointer);
+      if (inspectorScope) ReleaseScope(inspectorScope);
+      root.innerHTML = "";
+    },
+  };
+}
