+    // Signature tilted Shader Ball + beveled brushed metallic pedestal matching Image 2 & Image 3
+    const sphereGeo = createBallGeometry();
+    const mesh = new THREE.Mesh(sphereGeo, new THREE.MeshStandardMaterial());
