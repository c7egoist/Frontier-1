+    const hasPrev = closed || i > 0;
+    const hasNext = closed || i < count - 1;
+    if (!hasPrev && !hasNext) {
+      cur.in = null;
+      cur.out = null;
+      continue;
+    }
+    const prev = list[(i - 1 + count) % count];
+    const next = list[(i + 1) % count];
+    if (!hasPrev && hasNext) {
+      cur.in = null;
+      cur.out = { x: (next.x - cur.x) * (scale * 0.6), y: (next.y - cur.y) * (scale * 0.6) };
