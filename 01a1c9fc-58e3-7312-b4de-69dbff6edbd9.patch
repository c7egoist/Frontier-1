+                if (!VertEdges.has(Va)) VertEdges.set(Va, new Set());
+                if (!VertEdges.has(Vb)) VertEdges.set(Vb, new Set());
+                VertEdges.get(Va).add(K3);
+                VertEdges.get(Vb).add(K3);
